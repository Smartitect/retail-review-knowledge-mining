{
  "name": "retail-review-knowledge-mining",
  "image": "mcr.microsoft.com/devcontainers/base:noble",

  // No Python feature: uv owns the interpreter. A second Python on PATH wins silently.
  "features": {
    "ghcr.io/devcontainers/features/powershell:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "postCreateCommand": "pwsh ./.devcontainer/postCreateCommand.ps1",

  "containerEnv": {
    // Inside the workspace so rebuilds do not re-download, and on the same
    // filesystem as .venv so uv can hardlink rather than copy.
    "UV_CACHE_DIR": "/workspaces/retail-review-knowledge-mining/.uv-cache"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-vscode.powershell",
        "tamasfe.even-better-toml",
        "Anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "pwsh",
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": false,
        "files.exclude": {
          ".uv-cache": true
        }
      }
    }
  },

  "remoteUser": "vscode"
}
