# Copy to .env and fill in. .env is gitignored.
# Key for TypeSafe AI's Jev model: https://typesafe.ai
TYPESAFE_API_KEY=

# Azure AI Foundry chat deployment that writes review text for generated data.
# ENDPOINT is the resource's OpenAI-compatible base URL, e.g. https://<resource>.openai.azure.com/openai/v1/
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=
