# Copy to .env and fill in. .env is gitignored.
# Key for TypeSafe AI's Jev model: https://typesafe.ai
TYPESAFE_API_KEY=

# Azure AI Foundry: everything is read from this Key Vault with your `az login` identity.
KG_KEY_VAULT_URI=

# One secret bundle per model role: the prefix of four secrets in the vault,
#   <prefix>-endpoint     resource root, https://<resource>.services.ai.azure.com/
#   <prefix>-key          resource API key
#   <prefix>-api-version  Azure OpenAI API version, e.g. v1
#   <prefix>-deployment   deployment name
# The reflection model is the chat deployment that writes review text for generated data.
KG_REFLECTION_MODEL_SECRETS=
KG_EMBEDDING_MODEL_SECRETS=
