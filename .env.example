# Copy to .env and fill in. .env is gitignored: never commit it.

# Key for TypeSafe AI's Jev model: https://typesafe.ai
TYPESAFE_API_KEY=

# Azure AI Foundry: the chat deployment that writes review text and, through DSPy, is compared with Jev.
# From the Foundry portal (https://ai.azure.com): your resource's endpoint (https://<resource>.services.ai.azure.com/),
# its API key, and the name of your chat deployment.
KG_REFLECTION_MODEL_ENDPOINT=
KG_REFLECTION_MODEL_KEY=
KG_REFLECTION_MODEL_DEPLOYMENT=
# v1 is the version-less OpenAI API, and the only one the DSPy classifier supports.
KG_REFLECTION_MODEL_API_VERSION=v1
